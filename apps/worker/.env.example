# === CyberShield Worker Configuration ===

# URL of the CyberShield backend API
BACKEND_URL=http://localhost:8000

# --- WORKER ONLY — same secret as the backend ---
# Must match the WORKER_API_KEY set on the backend server.
WORKER_API_KEY=CHANGE_ME_TO_A_REAL_SECRET

# Directory for temporary APK downloads and analysis artifacts
WORK_DIR=./worker_data
