# === CyberShield Backend Configuration ===

# SQLite database URL (relative path is fine for development)
DATABASE_URL=sqlite+aiosqlite:///./cybershield.db

# Directory where uploaded APKs are stored
UPLOAD_DIR=./uploads

# Comma-separated list of allowed CORS origins (your frontend URL)
CORS_ORIGINS=http://localhost:3000

# --- BACKEND/WORKER ONLY — NEVER put this in the frontend ---
# Shared secret between the backend and the analysis worker.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
WORKER_API_KEY=CHANGE_ME_TO_A_REAL_SECRET
